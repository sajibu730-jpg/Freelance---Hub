<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FreelanceHub" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#071B2E</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.FreelanceHub.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#071B2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">#071B2E</item>
        <item name="postSplashScreenTheme">@style/Theme.FreelanceHub</item>
    </style>

</resources>
